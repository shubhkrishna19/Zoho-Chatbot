# ZohoChatbot (BlueBot) environment template
# Copy to .env for local development only. Do not commit real values.
# Production values belong in the Vercel dashboard.

# Required for live chatbot responses
MINIMAX_API_KEY=your_minimax_api_key_here

# Optional for live order-status lookups
# Leave blank until production OrderHub tracking is ready.
ORDER_HUB_BASE_URL=

# Optional overrides
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_BASE_URL=https://api.minimax.io/v1
DEBUG_LOGGING=false
